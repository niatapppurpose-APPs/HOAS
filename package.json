{
  "name": "hoas-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HOAS - Hostel Operations Accountability System (Full-Stack Workspace)",
  "scripts": {
    "client": "cd client && npm run dev",
    "backend": "cd hoas-backend && npm run dev",
    "server": "npm run backend",
    "dev": "node scripts/dev.mjs",
    "build": "cd client && npm run build",
    "install:client": "cd client && npm install",
    "install:server": "cd server/functions && npm install",
    "install:all": "npm run install:client && npm run install:server",
    "deploy": "cd server && firebase deploy --only functions"
  },
  "workspaces": [
    "client",
    "server/functions"
  ],
  "devDependencies": {
    "@heroicons/react": "^2.2.0",
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "driver.js": "^1.4.0",
    "firebase-functions": "^7.2.5",
    "lottie-react": "^2.4.1",
    "motion": "^13.1.0",
    "recharts": "^3.6.0",
    "resend": "^6.9.3"
  }
}
