{
  "name": "hoas-functions",
  "description": "Cloud Functions for HOAS (Hostel Operations Accountability System)",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "serve": "cd .. && firebase emulators:start --only functions",
    "shell": "cd .. && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "cd .. && firebase deploy --only functions",
    "logs": "cd .. && firebase functions:log"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.2.2",
    "fs": "^0.0.1-security",
    "nodemailer": "^8.0.1",
    "path": "^0.12.7",
    "pdfkit": "^0.15.0",
    "xlsx": "^0.18.5",
    "zip-lib": "^0.7.3"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.3.0"
  },
  "private": true
}
